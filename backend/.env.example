# LLM (через Avito AI прокси)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://avito-ai-proxy/anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://avito-ai-proxy/openai
