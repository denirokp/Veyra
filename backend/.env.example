# LLM — OpenAI-совместимый протокол.
# Поддерживает: Kimi/Moonshot, OpenAI, Avito AI proxy, любой другой OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=moonshot-v1-128k
# Опционально: дешёвая/быстрая модель для механических skills (извлечение
# сущностей и обещаний при индексации). Пусто → используется LLM_MODEL.
# LLM_MODEL_FAST=

# Embeddings — локальная модель (без интернета и без API).
# Первый запуск скачает ~500МБ в ~/.cache/huggingface, дальше офлайн.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/khronika.db

# Documents
DOCS_DIR=./data/docs
STYLE_ANCHORS_DIR=./data/style_anchors

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS — список origin'ов через запятую. Дефолт — только локальный фронт.
CORS_ORIGINS=http://localhost:5173

# Опциональная авторизация. Если задан — каждый запрос (кроме /health)
# должен иметь Authorization: Bearer <API_AUTH_TOKEN>. Пусто = открытый API.
# Прод-сценарий: сгенери случайный токен и впиши и сюда, и на фронт.
# API_AUTH_TOKEN=

# Лимит размера body для /api/chat и /api/initiative — защита от случайных
# мегабайтных payload'ов которые забьют LLM контекст.
MAX_REQUEST_BODY_MB=5

# Web search — опционально. Задай один из ключей для подгрузки внешнего
# контекста в research mode. Без ключа research работает только на pretrain
# знаниях LLM. Tavily лучше для research (платный, full page content),
# Brave дешевле (free tier 2000/мес, только snippets).
# Tavily приоритетнее если заданы оба.
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=BSA-...

# Background-skills при индексации: числовые расхождения, обещания,
# логические сигналы, document brief. Это "бульон" — проактивные находки.
# Включено по умолчанию. Выключи (=0) только при bulk-индексации огромных
# корпусов, чтобы не тратить ~6 LLM-вызовов на каждый документ.
# ENABLE_BACKGROUND_SIGNALS=1
#
# Опционально: пропустить только логические сигналы (pairwise-сравнение пар
# документов — самый дорогой skill), оставив остальной "бульон".
# DISABLE_LOGIC_SIGNALS=1
