#!/bin/sh
# Veyra G4 — регрессия перед push, если менялись поведенческие файлы
# (SKILL.md, промпты детекторов, ground truth).
#
# Установка (из корня репозитория):
#   ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#
# Хук интеграционный: требует поднятый бэкенд и LLM_API_KEY. Если прогнать
# не удалось — push НЕ блокируется (код 2), блокирует только реальная
# регрессия (код 1).

if python3 scripts/regression.py --check-changed >/dev/null 2>&1; then
    echo "[veyra] поведенческие файлы изменены — прогоняю регрессию…"
    python3 scripts/regression.py
    rc=$?
    if [ "$rc" -eq 1 ]; then
        echo "[veyra] регрессия обнаружена — push остановлен."
        echo "[veyra] проверь причину или обнови baseline:"
        echo "[veyra]   python scripts/regression.py --update-baseline"
        exit 1
    elif [ "$rc" -eq 2 ]; then
        echo "[veyra] регрессию не удалось прогнать (нет сервера / LLM_API_KEY)."
        echo "[veyra] push разрешён — прогони регрессию вручную."
    fi
fi
exit 0
